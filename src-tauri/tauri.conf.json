{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "K7Cabines PDV",
  "version": "0.2.1",
  "identifier": "br.com.dizevolv.k7cabines",
  "build": {
    "beforeDevCommand": "npm run desktop:web:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run desktop:web:build",
    "frontendDist": "../dist/desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "K7Cabines | PDV",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "maximized": true,
        "decorations": true,
        "focus": true,
        "visible": true,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "app",
      "dmg",
      "deb",
      "appimage"
    ],
    "category": "Business",
    "publisher": "Dizevolv",
    "copyright": "© Dizevolv",
    "shortDescription": "Ponto de venda offline K7 Cabines",
    "longDescription": "Ponto de venda offline para balcão: vendas, turno de caixa, estoque com lotes e validade, fornecedores, relatórios, impressão térmica e backup local. Funciona sem internet desde o primeiro uso.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "PortugueseBR"
        ],
        "displayLanguageSelector": false,
        "installMode": "perMachine"
      },
      "wix": {
        "language": [
          "pt-BR"
        ]
      },
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "cups"
        ]
      }
    }
  }
}
